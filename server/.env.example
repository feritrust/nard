# ─────────────────────────────────────────────────────────────
#  تنظیمات سرور بازی
#  این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
#  فایل .env هرگز نباید در گیت باشد.
# ─────────────────────────────────────────────────────────────

# پورتی که سرور روی آن گوش می‌دهد
PORT=8080

# آدرسی که سرور روی آن گوش می‌دهد.
# ⚠️ روی سرور واقعی (پشت nginx) حتماً 127.0.0.1 — وگرنه کسی می‌تواند
#    مستقیم به IP:8080 وصل شود و هدر IP را جعل کند.
# برای تست محلی روی موبایل، خالی بگذارید تا 0.0.0.0 شود.
NARD_HOST=127.0.0.1

# آیا هدرهای پراکسی (CF-Connecting-IP / X-Forwarded-For) قابل اعتمادند؟
# پشت nginx یا کلادفلر: 1  •  اگر سرور مستقیم در معرض اینترنت است: 0
NARD_TRUST_PROXY=1

# مسیر دیتابیس (پیش‌فرض: پوشه‌ی data کنار سرور)
# NARD_DATA=/var/lib/nard

# ⚠️ برای انتشار عمومی حتماً ۰ باشد.
# اگر ۱ بماند، کد تأیید پیامک در پاسخ سرور برمی‌گردد و
# هر کسی می‌تواند با هر شماره‌ای وارد شود.
NARD_DEV_CODE=0

# کلید امضای نشست‌ها. اگر خالی بماند هر بار ری‌استارت عوض می‌شود
# و همه‌ی کاربران باید دوباره وارد شوند. یک رشته‌ی تصادفی بلند بگذارید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NARD_SECRET=

# توکن ربات تلگرام — برای ورود از مینی‌اپ تلگرام
# NARD_BOT_TOKEN=

# وقتی درگاه پرداخت واقعی وصل شد این را ست کنید.
# با ست شدن آن، مسیر تسویه‌ی دستی بسته می‌شود و فقط
# callback خود درگاه می‌تواند سکه واریز کند.
# NARD_GATEWAY=zarinpal
