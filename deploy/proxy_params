# اگر /etc/nginx/proxy_params ندارید، محتوای این فایل را آنجا بگذارید
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;

# ⚠️ عمداً $proxy_add_x_forwarded_for نیست.
# با ماژول real_ip (فایل cloudflare-realip.conf) مقدار $remote_addr همان
# IP واقعی بازیکن است. اگر زنجیره را دست‌نخورده رد کنیم، کاربر می‌تواند
# خودش یک X-Forwarded-For جعلی بفرستد و اولین مقدار زنجیره جعلی شود —
# یعنی می‌تواند از فیلتر مولتی‌اکانت و محدودیت پیامک فرار کند.
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_http_version 1.1;
proxy_set_header Connection "";
